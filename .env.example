# =====================================================
# CLIENT & SERVER ENVIRONMENT CONFIGURATION
# =====================================================

# Public URL of the portfolio frontend
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Base URL of the Express backend API (optional, if using server)
NEXT_PUBLIC_API_URL=http://localhost:5000/api

# =====================================================
# RESEND EMAIL CONFIGURATION (Contact Form)
# =====================================================
# Generate your API key at: https://resend.com/api-keys
RESEND_API_KEY=re_your_api_key_here

# The verified sender email address.
# For testing/free accounts without a custom domain, use: onboarding@resend.dev
# For verified custom domains, use: Portfolio Contact <contact@yourdomain.com>
RESEND_FROM_EMAIL=Portfolio Contact <onboarding@resend.dev>

# The recipient email where contact form submissions should be delivered
RESEND_TO_EMAIL=your_email@example.com
